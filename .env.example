# Db2iLens Environment Variables
# 
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control (it's in .gitignore).
#
# For JDBC mode (IBM i / PUB400 connection):
# -----------------------------------------

# JT400 JDBC driver path (required for JDBC mode)
# Can also be set via JT400_JAR environment variable
# Default paths checked: ./jt400.jar, ~/.db2ilens/jt400.jar
# To download: ./scripts/fetch_jt400.sh
JT400_JAR=

# IBM i connection credentials (for scan command)
# These are REQUIRED when using --host, --user, --schema (JDBC mode)
# Use --password-stdin or DB2ILENS_PASSWORD to provide password securely
DB2ILENS_USER=
DB2ILENS_PASSWORD=

# PUB400-specific variables (alternative to DB2ILENS_* variables)
# Used in integration tests and for PUB400 demo
PUB400_HOST=pub400.com
PUB400_USER=
PUB400_PASSWORD=
PUB400_SCHEMA=

# For JDBC scan with table filtering
# Comma-separated list or SQL LIKE pattern (e.g., MLENS_%)
PUB400_TABLES=MLENS_%

# For materializing JDBC scan data to CSV (dbt external sources)
# These are used when running materialize_jdbc_scan_csvs
# DB2ILENS_USER and DB2ILENS_PASSWORD are used if PUB400_* are not set

# For offline mode: no environment variables are required
# Use: db2ilens scan --offline examples/mini_erp/ --out scan.yaml
